# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pricepulse?retryWrites=true&w=majority

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used only by `npm run seed` (demo accounts)
SEED_ADMIN_EMAIL=admin@pricepulse.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=demo@pricepulse.dev
SEED_USER_PASSWORD=User@12345
